{
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [80, 100, 120],
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true
  },
  "javascript.validate.enable": false,
  "typescript.validate.enable": true,
  "editor.formatOnSave": true,
  "todohighlight.keywords": [
    {
      "text": "NOTE:",
      "color": "yellow",
      "backgroundColor": "blue",
      "overviewRulerColor": "none"
    },
    {
      "text": "FEAT(#xx)",
      "regex": {
        "pattern": "FEAT\\(#\\d+\\):|FEAT:"
      },
      "color": "black",
      "backgroundColor": "darkorange",
      "overviewRulerColor": "None"
    },
    {
      "text": "FIXME(#xx)",
      "regex": {
        "pattern": "FIXME\\(#\\d+\\):|FIXME:"
      },
      "color": "white",
      "backgroundColor": "red",
      "overviewRulerColor": "darkorange"
    },
    {
      "text": "TODO(#xx)",
      "regex": {
        "pattern": "TODO\\(#\\d+\\):|TODO:"
      },
      "backgroundColor": "yellow",
      "color": "black",
      "overviewRulerColor": "None"
    }
  ],
  "css.styleSheets": ["nextapp/src/**/*.css"]
}
